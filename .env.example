# Kosongkan semua variabel Supabase untuk memakai MODE LOKAL
# (data disimpan di folder ./data, cocok untuk mencoba di komputer sendiri).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kunci rahasia untuk menandatangani cookie sesi di mode lokal.
# Jika kosong, dibuat otomatis di data/.secret
SESSION_SECRET=
